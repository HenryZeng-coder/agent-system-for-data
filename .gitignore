# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# 环境变量
.env

# 数据目录 (data/reports/ 下的报告产物需入库跟踪, 故不设忽略规则)
data/raw/
data/scored/
data/rated/

# Scrapy
crawler/jobs/
crawler/.scrapy

# 测试/覆盖率
.pytest_cache/
.coverage

# macOS
.DS_Store

# IDE
.vscode/
.idea/

# 临时文件 (*.log 默认忽略, 但 logs/ 下的运行日志需入库跟踪)
*.log
!logs/*.log
*.tmp

# 运行时状态
.llm_progress.json
