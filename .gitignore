# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# 环境变量
.env

# 本地可选配置 (只提交 .example 版本)
config/known_tech.json
config/stock_map.json

# 数据目录
data/raw/
data/scored/
data/rated/
data/reports/*.csv
data/reports/*.xlsx
data/reports/*.md
# individual.csv 是全链路最终产出, 需入库跟踪
!data/reports/individual.csv

# Scrapy
# 注意: .gitignore 只认行首 # 为注释, 不要写行尾注释 (会被当模式的一部分)
# crawler/jobs/ = 从 crawler/ 目录运行时生成
crawler/jobs/
# jobs/ = 从项目根运行 (如 python -m scrapy crawl) 时的落点
jobs/
crawler/.scrapy
.scrapy/

# 测试/覆盖率
.pytest_cache/
.coverage

# macOS
.DS_Store

# IDE
.vscode/
.idea/

# 临时文件
*.log
*.tmp

# macOS
.DS_Store

# 运行时状态
.llm_progress.json
